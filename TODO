Сделать функцию get-public-ip. Код уже есть

```
curl -s https://ipinfo.io/json | jq -r '
  . as $d |
  [$d.ip, $d.country] | @tsv
' | while IFS="$(printf '\t')" read -r ip country; do
  flag=$(python3 -c 'import sys; print("".join(chr(127397 + ord(c)) for c in sys.argv[1]))' "$country")

  echo "$flag  $ip"
done
```
